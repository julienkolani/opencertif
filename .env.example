# Local defaults: works as-is with `docker compose up` on your machine.
# For a server, start from .env.production instead (see README,
# "Mise en production pas à pas"); production values are given in comments.

# --- Application ---
# Production: https://certifs.<domain>
BASE_URL=http://localhost:8501
# DEV_MODE=true bypasses Keycloak auth entirely and injects a fake admin user.
# Never enable in production.
DEV_MODE=false
# Comma-separated list of allowed CORS origins (production: https://certifs.<domain>)
CORS_ORIGINS=http://localhost:8501
DB_PATH=data/certificates.db
TEMPLATES_DIR=data/templates
CERTIFS_DIR=data/certifs
POSITIONS_FILE=data/template_positions.json

# --- Front -> API ---
# Used by the front (Streamlit) to reach the API. Under `docker compose up`,
# "api" is the API service's hostname on the compose network (NOT
# localhost:8000; that would resolve to the front container itself).
# Running the front outside Docker (e.g. `streamlit run front/app.py`
# against a locally-running API), use http://localhost:8000 instead.
API_URL=http://api:8000

# --- Keycloak / OIDC ---
# Full issuer URL (with scheme), used by the API/front for OIDC discovery
# (production: https://auth.<domain>).
KEYCLOAK_URL=http://localhost:8080
# Bare hostname (no scheme), used as KC_HOSTNAME by the keycloak service itself
# so the OIDC issuer it returns is consistent between browser and server
# (production: auth.<domain>).
KC_HOSTNAME=localhost
# Keycloak start command: start-dev (local) or start (production: stricter
# checks, expects the nginx reverse proxy).
KC_START_MODE=start-dev
# Address the published ports bind to: 0.0.0.0 locally, 127.0.0.1 in
# production (services then only reachable through nginx).
BIND_ADDR=0.0.0.0
KEYCLOAK_REALM=opencertif
KEYCLOAK_CLIENT_ID=opencertif-app
KEYCLOAK_CLIENT_SECRET=
# Bootstrap admin account created on first Keycloak start. Change the
# password before deploying, then rotate it from the admin console.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Password for Keycloak's own Postgres database (keycloak-db service).
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(24))"
KEYCLOAK_DB_PASSWORD=change-me-in-production

# --- SMTP ---
# Ces valeurs sont un fallback : la config SMTP peut aussi être gérée
# dynamiquement depuis l'UI (page Emails), auquel cas elle est stockée
# (chiffrée si SECRET_KEY est défini) dans la table `settings` et prend
# le pas sur ces variables.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Chiffrement ---
# Protège les secrets stockés en base (ex : mot de passe SMTP saisi depuis
# l'UI). Sans cette variable, ces valeurs sont stockées en clair en DB.
# Changez cette valeur en production et ne la committez jamais dans git.
SECRET_KEY=change-me-in-production
