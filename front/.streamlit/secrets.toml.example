# OpenCertif : secrets Streamlit (auth OIDC native, st.login()/st.logout()/st.user)
#
# Copiez ce fichier vers .streamlit/secrets.toml (NE JAMAIS committer ce
# dernier : il contient un secret) et remplissez les valeurs ci-dessous.
# Sans ce fichier, la connexion admin/viewer ne fonctionne pas : seule la
# page publique /verifier reste utilisable (ou passez DEV_MODE=true côté
# API pour développer sans Keycloak).
#
#   cp front/.streamlit/secrets.toml.example front/.streamlit/secrets.toml
#
# Ce fichier n'est jamais copié dans l'image (front/.dockerignore) :
# docker-compose.yml le monte en lecture seule dans le conteneur front.

[auth]
# URL absolue de l'app, terminée par /oauth2callback. Doit correspondre à
# une Redirect URI déclarée sur le client Keycloak "opencertif-app".
redirect_uri = "https://certifs.DOMAIN/oauth2callback"
# Secret de signature du cookie de session : valeur aléatoire et longue,
# propre à cette instance (générez-en une avec :
# `python3 -c "import secrets; print(secrets.token_hex(32))"`).
cookie_secret = "CHANGE_ME_RANDOM_SECRET"
# Doit correspondre au client Keycloak "opencertif-app" (clientId dans
# keycloak/realm-export.json) et à KEYCLOAK_CLIENT_ID dans .env.
client_id = "opencertif-app"
# Même valeur que KEYCLOAK_CLIENT_SECRET dans .env (Clients > opencertif-app
# > Credentials dans la console Keycloak, voir README, section
# "Configurer Keycloak").
client_secret = "CHANGE_ME_CLIENT_SECRET"
# Endpoint de découverte OIDC du realm opencertif.
server_metadata_url = "https://auth.DOMAIN/realms/opencertif/.well-known/openid-configuration"
# Indispensable : sans cette ligne, st.user.tokens est vide, le front
# n'envoie aucun token à l'API (401) et l'admin est renvoyé sur la page
# publique « Vérifier ». "access" porte aussi les rôles (realm_access).
expose_tokens = ["access", "id"]
